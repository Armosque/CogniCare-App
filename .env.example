
# Azure Cosmos DB Endpoint
# Copy from Azure Portal > Your Cosmos DB > Keys > URI
AZURE_COSMOS_ENDPOINT=https://your-cosmos-name.documents.azure.com:443/

# Azure Cosmos DB Primary Key
# Copy from Azure Portal > Your Cosmos DB > Keys > Primary Key
AZURE_COSMOS_KEY=your-primary-key

# ========================================
# OPTIONAL - Sensible defaults provided
# ========================================

# Azure Cosmos DB Database ID
AZURE_COSMOS_DATABASE_ID=cognicare

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Backend Debug Mode (true/false)
BACKEND_DEBUG=false

# Frontend API URL
NEXT_PUBLIC_API_URL=http://backend:8000

# Node Environment (development/production)
NODE_ENV=development

# ========================================
# OPTIONAL - Azure AD Authentication
# ========================================

AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# ========================================
# OPTIONAL - Azure AI Services
# ========================================

AZURE_AI_KEY=
AZURE_AI_ENDPOINT=

# ========================================
# LEGACY - From original setup (deprecated)
# ========================================

AZURE_AI_AGENT_KEY=
AZURE_AI_AGENT_ENDPOINT=
AZURE_AI_DEPLOYMENT_NAME=Phi-4
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBDOMAIN=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
