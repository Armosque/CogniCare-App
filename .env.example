# NextAuth Configuration
NEXTAUTH_SECRET=your-random-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Azure AD (Microsoft Entra ID) Configuration
AZURE_AD_CLIENT_ID=your-client-id-from-azure
AZURE_AD_CLIENT_SECRET=your-client-secret-from-azure
AZURE_AD_TENANT_ID=your-tenant-id

# Azure Cosmos DB Configuration
AZURE_COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
AZURE_COSMOS_KEY=your-cosmos-primary-key
AZURE_COSMOS_DATABASE_ID=CogniCareDB

# Azure AI Services Configuration
AZURE_AI_AGENT_KEY=your-ai-api-key
AZURE_AI_AGENT_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
AZURE_AI_DEPLOYMENT_NAME=Phi-4

# Azure Immersive Reader Configuration
READER_TENANT_ID=your-reader-tenant-id
READER_CLIENT_ID=your-reader-client-id
READER_CLIENT_SECRET=your-reader-client-secret
